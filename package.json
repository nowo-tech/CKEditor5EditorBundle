{
  "name": "@nowo-tech/ckeditor5-editor-bundle",
  "version": "1.0.0",
  "description": "Vite + CKEditor 5 build for Ckeditor5 Editor Bundle (TypeScript)",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "vite build && vite build -c vite.loader.config.ts",
    "dev": "vite build --watch",
    "watch:loader": "vite build -c vite.loader.config.ts --watch",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ckeditor5": "^49.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "author": "H\u00e9ctor Franco Aceituno <hectorfranco@nowo.tech>",
  "license": "MIT"
}
