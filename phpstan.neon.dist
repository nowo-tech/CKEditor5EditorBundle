includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    # Includes ruleset-worker + flagRequestSuperglobals (scenario B / reset_kernel=false hygiene)
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - tests/Fixtures/app/var (?)
    bootstrapFiles:
        - vendor/autoload.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
