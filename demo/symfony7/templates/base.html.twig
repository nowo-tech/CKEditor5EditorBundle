<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body.ckeditor5-demo-dark { background-color: #0f172a; color: #e2e8f0; }
        body.ckeditor5-demo-dark .lead, body.ckeditor5-demo-dark .text-muted { color: #94a3b8 !important; }
    </style>
</head>
<body>
    {% set _locale = app.request.locale %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home', { _locale: _locale }) }}">{{ 'demo.title'|trans({}, 'messages') }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ckeditorDemoNavbar" aria-controls="ckeditorDemoNavbar" aria-expanded="false" aria-label="{{ 'demo.menu_toggle_aria'|trans({}, 'messages') }}">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ckeditorDemoNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}" href="{{ path('app_home', { _locale: _locale }) }}">{{ 'demo.menu_home'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo' ? 'active' : '' }}" href="{{ path('app_demo', { _locale: _locale }) }}">{{ 'demo.menu_demo'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_configs' ? 'active' : '' }}" href="{{ path('app_demo_configs', { _locale: _locale }) }}">{{ 'demo.menu_configs'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_inline_config' ? 'active' : '' }}" href="{{ path('app_demo_inline_config', { _locale: _locale }) }}">{{ 'demo.menu_inline_config'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_variants' ? 'active' : '' }}" href="{{ path('app_demo_variants', { _locale: _locale }) }}">{{ 'demo.menu_variants'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_emoji' ? 'active' : '' }}" href="{{ path('app_demo_emoji', { _locale: _locale }) }}">{{ 'demo.menu_emoji'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_typography' ? 'active' : '' }}" href="{{ path('app_demo_typography', { _locale: _locale }) }}">{{ 'demo.menu_typography'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_variables' ? 'active' : '' }}" href="{{ path('app_demo_variables', { _locale: _locale }) }}">{{ 'demo.menu_variables'|trans({}, 'messages') }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_demo_upload_images' ? 'active' : '' }}" href="{{ path('app_demo_upload_images', { _locale: _locale }) }}">{{ 'demo.menu_upload_images'|trans({}, 'messages') }}</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <button type="button" class="btn btn-sm btn-outline-light" id="ckeditor5-demo-theme-toggle" title="{{ 'demo.theme_toggle_title'|trans({}, 'messages') }}">{{ 'demo.theme_dark'|trans({}, 'messages') }}</button>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">{{ _locale == 'es' ? 'Español' : 'English' }}</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_home', { _locale: 'en' }) }}">English</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_home', { _locale: 'es' }) }}">Español</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    {% block body %}{% endblock %}
    {# CKEditor 5 IIFE: monta editores en [data-ckeditor5-root]; requiere `bin/console assets:install public` en la app #}
    <script src="{{ asset(nowo_ckeditor5_editor_asset_path('ckeditor5-editor.js'), nowo_ckeditor5_editor_asset_package()) }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
(function () {
    var KEY = 'ckeditor5DemoDark';
    function apply(dark) {
        document.body.classList.toggle('ckeditor5-demo-dark', dark);
        document.body.classList.toggle('ckeditor5-demo-light', !dark);
        document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
        var nav = document.querySelector('.navbar.navbar-dark.bg-dark');
        if (nav) {
            nav.classList.toggle('navbar-dark', dark);
            nav.classList.toggle('bg-dark', dark);
            nav.classList.toggle('navbar-light', !dark);
            nav.classList.toggle('bg-light', !dark);
        }
        var btn = document.getElementById('ckeditor5-demo-theme-toggle');
        if (btn) {
            btn.textContent = dark
                ? '{{ 'demo.theme_light'|trans({}, 'messages')|e('js') }}'
                : '{{ 'demo.theme_dark'|trans({}, 'messages')|e('js') }}';
            btn.classList.toggle('btn-outline-dark', dark);
            btn.classList.toggle('btn-outline-light', !dark);
        }
    }
    var stored = localStorage.getItem(KEY);
    var dark = stored === null ? false : stored === '1';
    apply(dark);
    document.getElementById('ckeditor5-demo-theme-toggle')?.addEventListener('click', function () {
        dark = !document.body.classList.contains('ckeditor5-demo-dark');
        localStorage.setItem(KEY, dark ? '1' : '0');
        apply(dark);
    });
})();
    </script>
</body>
</html>
