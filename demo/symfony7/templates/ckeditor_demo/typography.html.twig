{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.typography_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1>{{ 'demo.typography_page_title'|trans({}, 'messages') }}</h1>
    <p class="lead text-muted">{{ 'demo.typography_page_lead'|trans({}, 'messages') }}</p>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_row(form.content) }}
        <button type="submit" class="btn btn-primary">{{ 'demo.submit'|trans({}, 'messages') }}</button>
    {{ form_end(form) }}

    {% if saved_value is defined and saved_value != '' %}
        <hr class="my-4">
        <p class="text-muted small">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        <pre class="border rounded p-3 bg-light small">{{ saved_value|e }}</pre>
    {% endif %}

    <div class="alert alert-light border mt-4 small" role="note">
        <strong>{{ 'demo.typography_config_note_title'|trans({}, 'messages') }}</strong>
        <pre class="mb-0 mt-2 bg-white border rounded p-3">{{ 'demo.typography_config_snippet'|trans({}, 'messages') }}</pre>
    </div>
</div>
{% endblock %}
