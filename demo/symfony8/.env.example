# Demo: dev environment (Web Profiler, debug toolbar). docker-compose also forces APP_ENV=dev.
# PORT: host port published by docker-compose for the demo web server (http://localhost:PORT).
PORT=8021

###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev` (Web Profiler, debug toolbar).
APP_ENV=dev
# APP_DEBUG: enable detailed debug output (`1` in dev, `0` in prod).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# APP_SECRET: secret used by Symfony for signing (CSRF, signed URLs). Local-only placeholder; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8021
###< symfony/routing ###

###> demo / nowo_ckeditor5_editor folio_env profile ###
# CSS min-height for profile "folio_env" (see config/packages/nowo_ckeditor5_editor.yaml)
DEMO_CKEDITOR_FOLIO_MIN_HEIGHT=min(68vh,620px)
###< demo / nowo_ckeditor5_editor folio_env profile ###
