{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The light/dark toggle is UiKit's. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _locale = app.request.locale %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('app_home', { _locale: _locale }) }}">{{ 'demo.title'|trans({}, 'messages') }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.title'|trans({}, 'messages') }}">
            {% for item in [
                {route: 'app_home', label: 'demo.menu_home'},
                {route: 'app_demo', label: 'demo.menu_demo'},
                {route: 'app_demo_configs', label: 'demo.menu_configs'},
                {route: 'app_demo_inline_config', label: 'demo.menu_inline_config'},
                {route: 'app_demo_variants', label: 'demo.menu_variants'},
                {route: 'app_demo_emoji', label: 'demo.menu_emoji'},
                {route: 'app_demo_typography', label: 'demo.menu_typography'},
                {route: 'app_demo_variables', label: 'demo.menu_variables'},
                {route: 'app_demo_upload_images', label: 'demo.menu_upload_images'},
                {route: 'app_demo_lazy', label: 'demo.menu_lazy'},
            ] %}
                <a class="nowo-ui-link" href="{{ path(item.route, { _locale: _locale }) }}"{% if _route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans({}, 'messages') }}</a>
            {% endfor %}
        </nav>
        <div class="nowo-ui-header__end">
            <a class="nowo-ui-link" href="{{ path(_route|default('app_home'), { _locale: 'en' }) }}"{% if _locale == 'en' %} aria-current="true"{% endif %}>English</a>
            <a class="nowo-ui-link" href="{{ path(_route|default('app_home'), { _locale: 'es' }) }}"{% if _locale == 'es' %} aria-current="true"{% endif %}>Español</a>
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# CKEditor 5 IIFE: mounts editors on [data-ckeditor5-root]; requires `bin/console assets:install public` in the app. Pages can override with the lazy loader. #}
    {% block ckeditor5_script %}{{ nowo_ckeditor5_editor_script() }}{% endblock %}
{% endblock %}
