{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _loc = app.request.locale %}
{% set nowo_ui_demo_platform = {
    bundle: 'CKEditor 5 Editor',
    home_route: 'app_home',
    home_params: {_locale: _loc},
    repository: 'https://github.com/nowo-tech/CKEditor5EditorBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    nav: [
        {label: 'demo.menu_home', route: 'app_home', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_demo', route: 'app_demo', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_configs', route: 'app_demo_configs', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_inline_config', route: 'app_demo_inline_config', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_variants', route: 'app_demo_variants', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_emoji', route: 'app_demo_emoji', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_typography', route: 'app_demo_typography', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_variables', route: 'app_demo_variables', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_upload_images', route: 'app_demo_upload_images', params: {_locale: _loc}, section: 'demo.nav_section'},
        {label: 'demo.menu_lazy', route: 'app_demo_lazy', params: {_locale: _loc}, section: 'demo.nav_section'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# CKEditor 5 IIFE: mounts editors on [data-ckeditor5-root]; requires `bin/console assets:install public` in the app. Pages can override with the lazy loader. #}
    {% block ckeditor5_script %}{{ nowo_ckeditor5_editor_script() }}{% endblock %}
{% endblock %}
