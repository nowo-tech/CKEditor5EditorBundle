{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.typography_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.typography_page_title'|trans({}, 'messages'),
        intro: 'demo.typography_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(form) }}

    {% if saved_value is defined and saved_value != '' %}
        <p class="nowo-ui-muted">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        <pre class="nowo-ui-code-block">{{ saved_value|e }}</pre>
    {% endif %}

    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
        <strong>{{ 'demo.typography_config_note_title'|trans({}, 'messages') }}</strong>
        <pre class="nowo-ui-code-block">{{ 'demo.typography_config_snippet'|trans({}, 'messages') }}</pre>
    </div>
{% endblock %}
