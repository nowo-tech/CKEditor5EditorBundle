{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.menu_demo'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(form) }}

    {% if saved_value is defined and saved_value != '' %}
        <p class="nowo-ui-muted">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        <pre class="nowo-ui-code-block">{{ saved_value|e }}</pre>
    {% endif %}
{% endblock %}
