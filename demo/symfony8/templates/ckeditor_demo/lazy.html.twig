{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.lazy_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block ckeditor5_script %}{{ nowo_ckeditor5_editor_script({lazy: true}) }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <button type="button" class="nowo-ui-btn nowo-ui-btn--primary" id="ckeditor5-lazy-open" data-nowo-ui-dialog-open="ckeditor5-lazy-dialog">{{ 'demo.lazy_open'|trans({}, 'messages') }}</button>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.lazy_page_title'|trans({}, 'messages'),
        intro: 'demo.lazy_page_lead'|trans({}, 'messages'),
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {{ include('ckeditor_demo/_preview.html.twig') }}
    {{ include('ckeditor_demo/_snippet.html.twig', {snippet_title: 'demo.lazy_snippet_title', snippet_raw: '{{ nowo_ckeditor5_editor_script({lazy: true}) }}'}) }}
{% endblock %}

{% block nowo_ui_modals %}
    {% set _footer %}
        <button type="button" class="nowo-ui-btn nowo-ui-btn--outline" id="ckeditor5-lazy-close" data-nowo-ui-dialog-close>{{ 'demo.lazy_close'|trans({}, 'messages') }}</button>
        {{ form_widget(form.submit) }}
    {% endset %}
    {% embed nowo_ui_partial('dialog') with {id: 'ckeditor5-lazy-dialog', title: 'demo.lazy_page_title'|trans({}, 'messages'), size: 'wide', footer: _footer} %}
        {% block nowo_ui_dialog_body %}
            {{ form_start(form, {attr: {id: 'demo-editor-form', class: 'nowo-ui-form'}}) }}
                {% for child in form %}
                    {% if child.vars.name != 'submit' %}{{ form_row(child) }}{% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
