{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.lazy_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block ckeditor5_script %}{{ nowo_ckeditor5_editor_script({lazy: true}) }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.lazy_page_title'|trans({}, 'messages'),
        intro: 'demo.lazy_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <p>
        <button type="button" class="nowo-ui-btn nowo-ui-btn--primary" id="ckeditor5-lazy-open">{{ 'demo.lazy_open'|trans({}, 'messages') }}</button>
        <span class="nowo-ui-muted" id="ckeditor5-lazy-status" data-loaded="{{ 'demo.lazy_status_loaded'|trans({}, 'messages') }}">{{ 'demo.lazy_status_waiting'|trans({}, 'messages') }}</span>
    </p>

    <dialog id="ckeditor5-lazy-dialog" class="nowo-ui-dialog nowo-ui-dialog--lg">
        {{ form_start(form) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            <button type="button" class="nowo-ui-btn nowo-ui-btn--outline" id="ckeditor5-lazy-close">{{ 'demo.lazy_close'|trans({}, 'messages') }}</button>
        {{ form_end(form) }}
    </dialog>

    {% if saved_value is defined and saved_value != '' %}
        <p class="nowo-ui-muted">{{ 'demo.saved_preview'|trans({}, 'messages') }}</p>
        <pre class="nowo-ui-code-block">{{ saved_value|e }}</pre>
    {% endif %}

    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
        <strong>{{ 'demo.lazy_snippet_title'|trans({}, 'messages') }}</strong>
        <pre class="nowo-ui-code-block">{{ '{{ nowo_ckeditor5_editor_script({lazy: true}) }}' }}</pre>
    </div>
<script>
(function () {
    var dialog = document.getElementById('ckeditor5-lazy-dialog');
    var status = document.getElementById('ckeditor5-lazy-status');
    document.getElementById('ckeditor5-lazy-open').addEventListener('click', function () { dialog.showModal(); });
    document.getElementById('ckeditor5-lazy-close').addEventListener('click', function () { dialog.close(); });
    var timer = setInterval(function () {
        if (window.NowoCkeditor5Editor) {
            status.textContent = status.getAttribute('data-loaded');
            clearInterval(timer);
        }
    }, 250);
})();
</script>
{% endblock %}
