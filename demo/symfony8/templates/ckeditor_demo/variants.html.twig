{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.variants_page_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.variants_page_title'|trans({}, 'messages'),
        intro: 'demo.variants_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
        <strong>{{ 'demo.variants_yaml_note_title'|trans({}, 'messages') }}</strong>
        <pre class="nowo-ui-code-block">{{ 'demo.variants_yaml_snippet'|trans({}, 'messages') }}</pre>
    </div>

    {{ form_start(form) }}

    {% for child in form %}
        {% if not child.rendered %}
            {% if child.vars.name == 'content_compact' %}
                <h2 class="nowo-ui-card__title">{{ 'demo.section_heights'|trans({}, 'messages') }}</h2>
        <p class="nowo-ui-muted">{{ 'demo.section_heights_hint'|trans({}, 'messages') }}</p>
            {% endif %}
            {% if child.vars.name == 'content_dark' %}
                <h2 class="nowo-ui-card__title">{{ 'demo.section_themes'|trans({}, 'messages') }}</h2>
        <p class="nowo-ui-muted">{{ 'demo.section_themes_hint'|trans({}, 'messages') }}</p>
            {% endif %}
            {% if child.vars.name == 'content_reading' %}
                <h2 class="nowo-ui-card__title">{{ 'demo.section_misc'|trans({}, 'messages') }}</h2>
        <p class="nowo-ui-muted">{{ 'demo.section_misc_hint'|trans({}, 'messages') }}</p>
            {% endif %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
    {{ form_end(form) }}
{% endblock %}
