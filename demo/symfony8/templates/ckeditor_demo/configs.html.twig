{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.menu_configs'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.configs_page_title'|trans({}, 'messages'),
        intro: 'demo.configs_page_lead'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    {{ form_start(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {% if child.vars.name == 'content_standard' %}
                    <h2 class="nowo-ui-card__title">{{ 'demo.section_standard'|trans({}, 'messages') }}</h2>
        <p class="nowo-ui-muted">{{ 'demo.section_standard_hint'|trans({}, 'messages') }}</p>
                {% endif %}
                {% if child.vars.name == 'content_simple' %}
                    <h2 class="nowo-ui-card__title">{{ 'demo.section_simple'|trans({}, 'messages') }}</h2>
        <p class="nowo-ui-muted">{{ 'demo.section_simple_hint'|trans({}, 'messages') }}</p>
                {% endif %}
                {% if child.vars.name == 'content_minimal' %}
                    <h2 class="nowo-ui-card__title">{{ 'demo.section_minimal'|trans({}, 'messages') }}</h2>
        <p class="nowo-ui-muted">{{ 'demo.section_minimal_hint'|trans({}, 'messages') }}</p>
                {% endif %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {{ form_end(form) }}
{% endblock %}
